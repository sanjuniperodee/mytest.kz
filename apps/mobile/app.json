{
  "expo": {
    "name": "My Test",
    "owner": "sanjuniperodee",
    "slug": "mobile",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2A2826"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sanjuniperodee.mobile",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "My Test"
      }
    },
    "android": {
      "package": "com.sanjuniperodee.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2A2826"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "react-native-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "Фото нужны, чтобы вы могли загрузить аватарку или отправить картинку в чат. / Photos are used only when you choose an avatar or attach a picture in chat.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Микрофон нужен только для записи голосовых сообщений в чате, после нажатия на кнопку записи. / The microphone is used only to record voice messages in chat after you tap the record button."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cdb0e735-5aa6-4490-9fd3-b491a0c7fb4e"
      }
    }
  }
}
