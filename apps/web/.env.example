# Публичный URL сайта (canonical для /privacy, /terms, /support, /mobile)
NEXT_PUBLIC_SITE_URL=https://my-test.kz

# Nest API origin used by Next.js route handlers
NEXT_PUBLIC_API_BASE_URL=https://api.my-test.kz

# Ссылки на сторы для страницы /mobile (после публикации приложения)
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.sanjuniperodee.mobile
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXX

# Включить Vercel Analytics (опционально)
# NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=true

# Server-only: где Next ходит в Nest API на этой же машине (прокси /api/v1/*, отчёт для родителей).
# На проде: http://127.0.0.1:3001. Не задано — ходит на NEXT_PUBLIC_API_BASE_URL (публичный адрес), и тогда
# лимиты запросов в API видят один IP (самого сервера) на всех посетителей сайта.
# API_INTERNAL_URL=http://127.0.0.1:3001
